# ============================================================
# AI(FastAPI) 환경변수 예시
# 복사해서 사용:  cp .env.example .env   (.env 는 gitignore 대상)
# 출처: config/settings.py + config/swagger_config.py 전수 확인
# 참고: AI 서버는 S3/AWS를 사용하지 않습니다. 외부 키는 OpenAI 하나뿐.
# ============================================================

# ===== Redis (필수) — 없으면 앱이 부팅 시 죽습니다 =====
# 로컬 도커: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# ===== MySQL (필수) =====
# DB_URL은 jdbc:mysql://... 또는 mysql://... 둘 다 가능 (코드가 자동 변환)
DB_URL=mysql://localhost:3306/boini
DB_USERNAME=root
DB_PASSWORD=changeme

# ===== OpenAI (요약/리포트 기능 쓸 때 필요) =====
# 비워두면 요약 기능만 비활성화되고 서버는 정상 기동
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUMMARY_MAX_LINES=3

# ===== CORS =====
ALLOW_ORIGINS=http://localhost:8080,http://localhost:5173

# ===== 선택 =====
# APP_NAME=Boini AI Report
# API_PREFIX=/report
# CONTEXT_PATH=/         # 스웨거 경로용 (config/swagger_config.py)
